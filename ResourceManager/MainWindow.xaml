<Window x:Class="ResourceManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ResourceManager"
        mc:Ignorable="d"
        Title="MainWindow" Height="700" Width="1000">
    <Window.Resources>
        <Style x:Key="ConfigurationButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#26352F"/>
            <Setter Property="Background" Value="#E8F0E9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="15,10"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                            Property="Background"
                                            Value="#D2E3D4"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                            Property="Background"
                                            Value="#BDD5C0"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                            Property="Opacity"
                                            Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Boczne menu -->
        <StackPanel Grid.Column="0" Background="#1D3025" Width="240">
            <StackPanel.Resources>
                <!-- Wspólny styl dla nowoczesnych przycisków menu (wzorowany na obrazku) -->
                <FontFamily x:Key="MaterialSymbols">/ResourceManager;component/Fonts/#Material Symbols Rounded</FontFamily>
                <Style x:Key="ModernMenuButtonStyle" TargetType="RadioButton">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#A3B899"/>
                    <Setter Property="Height" Value="42"/>
                    <Setter Property="Margin" Value="12,3,12,3"/>
                    <Setter Property="GroupName" Value="MenuTabs"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="RadioButton">
                                <!-- Zaokrąglone rogi (CornerRadius) całego przycisku -->
                                <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="10" 
                                SnapsToDevicePixels="True">
                                    <Grid Margin="15,0,15,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>


                                        <TextBlock Grid.Column="0" 
                                           Text="{TemplateBinding Tag}" 
                                           FontFamily="{StaticResource MaterialSymbols}"
                                           FontSize="16" 
                                           Foreground="{TemplateBinding Foreground}"
                                           VerticalAlignment="Center" 
                                           HorizontalAlignment="Left"
                                           Typography.StandardLigatures="True"/>

                                        <!-- Tekst przycisku -->
                                        <ContentPresenter Grid.Column="1" 
                                                  VerticalAlignment="Center" 
                                                  Margin="5,0,0,0"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <!-- Efekt po najechaniu myszką (Hover) -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#2A3F33"/>
                                        <Setter Property="Foreground" Value="#E2EBE0"/>
                                    </Trigger>
                                    <!-- Stan aktywny / kliknięty (Zaznaczony na obrazku Dashboard) -->
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#2D4639"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

            </StackPanel.Resources>

            <!-- Nagłówek MENU -->
            <TextBlock Text="MENU"
               Foreground="#738A75"
               FontSize="12"
               FontWeight="SemiBold"
               Margin="25,25,10,15"/>

            <!-- Przyciski nawigacyjne z dopasowanymi ikonami systemowymi Windows -->
            <RadioButton x:Name="DashboardNavButton" Content="Dashboard" 
                 Style="{StaticResource ModernMenuButtonStyle}" 
                 Tag="&#xE871;" 
                 IsChecked="True"
                 Click="Dashboard_Click"/>

            <RadioButton Content="Add Entry" 
                 Style="{StaticResource ModernMenuButtonStyle}" 
                 Tag="&#xe147;" 
                 Click="AddEntry_Click"/>

            <RadioButton Content="Complete Translations" 
                 Style="{StaticResource ModernMenuButtonStyle}" 
                 Tag="&#xe8e2;"
                 Click="CompleteTranslations_Click"/>

            <RadioButton Content="Add new language" 
                 Style="{StaticResource ModernMenuButtonStyle}" 
                 Tag="&#xe894;"
                 Click="AddNewLanguage_Click"/>

            <RadioButton Content="Browse Resources" 
                 Style="{StaticResource ModernMenuButtonStyle}" 
                 Tag="&#xe896;"
                 Click="BrowseResources_Click"/>

            <RadioButton x:Name="SettingsNavButton" Content="Settings" 
             Style="{StaticResource ModernMenuButtonStyle}" 
             Tag="&#xe8b8;"
             Click="Settings_Click"/>

        </StackPanel>

        <!-- Obszar wyświetlania widoków -->
        <ContentControl x:Name="MainContent"
                        Grid.Column="1"/>

        <Grid x:Name="FolderOverlay"
              Grid.ColumnSpan="2"
              Background="#CC000000"
              Panel.ZIndex="100"
              Visibility="Collapsed">

            <Border Background="#26352F"
            CornerRadius="12"
            Padding="35"
            Width="420"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

                <StackPanel>
                    <TextBlock Text="RESOURCE MANAGER"
                       Foreground="White"
                       FontSize="22"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

                    <TextBlock Text="Select a project folder"
                       Foreground="White"
                       FontSize="20"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>

                    <TextBlock Text="To get started, choose a folder containing Resources.resx files"
                       Foreground="#D0D8D3"
                       FontSize="14"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,0,0,25"/>

                    <Button Content="Select a folder"
                    Width="180"
                    Height="44"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="#26352F"
                    Background="#E8F0E9"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="SelectProjectFolder_Click"
                    Style="{StaticResource ConfigurationButtonStyle}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="ResxSelectionOverlay"
          Grid.ColumnSpan="2"
          Background="#CC000000"
          Panel.ZIndex="101"
          Visibility="Collapsed">

            <Border Background="#26352F"
            CornerRadius="12"
            Padding="35"
            Width="480"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

                <StackPanel>

                    <TextBlock Text="RESOURCE MANAGER"
                       Foreground="White"
                       FontSize="22"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

                    <TextBlock Text="Configure resource files"
                       Foreground="White"
                       FontSize="20"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>

                    <TextBlock Text="Select the base language file and the target language file."
                       Foreground="#D0D8D3"
                       FontSize="14"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,0,0,25"/>

                    <TextBlock Text="Base language"
                       Foreground="White"
                       Margin="0,0,0,7"/>

                    <ComboBox x:Name="BaseFileComboBox" Margin="0,0,0,7"/>

                    <TextBlock Text="Target language"
                       Foreground="White"
                       Margin="0,0,0,7"/>

                    <ComboBox x:Name="TargetFileComboBox" Margin="0,0,0,7"/>

                    <TextBlock Text="Target language"
                       Foreground="White"
                       Margin="0,0,0,7"/>

                    <ComboBox x:Name="TargetLanguageComboBox" Margin="0,0,0,7"/>


                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Button Content="Continue" Grid.Column="0"
                        Click="ContinueConfigurationFiles_Click"
                        FontSize="14" Margin="10"/>

                        <Button Content="Add new language" Grid.Column="2"
                        FontSize="14" Margin="10"/>
                        
                    </Grid>


                    

                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="GeminiOverlay"
          Grid.ColumnSpan="2"
          Background="#CC000000"
          Panel.ZIndex="101">

            <Border Background="#26352F"
            CornerRadius="12"
            Padding="35"
            Width="440"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

                <StackPanel>

                    <TextBlock Text="RESOURCE MANAGER"
                       Foreground="White"
                       FontSize="22"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

                    <TextBlock Text="Configure AI translations"
                       Foreground="White"
                       FontSize="20"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>

                    <TextBlock Text="Enter your Gemini API key to enable AI-powered features."
                       Foreground="#D0D8D3"
                       FontSize="14"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,0,0,20"/>

                    <TextBlock Text="Gemini API Key"
                       Foreground="White"
                       FontWeight="SemiBold"
                       Margin="0,0,0,7"/>

                    <PasswordBox x:Name="ApiKeyPasswordBox"
                         Height="38"
                         Padding="8"
                         FontSize="14"
                         Margin="0,0,0,12"/>

                    <TextBlock Margin="0,0,0,15"
                           HorizontalAlignment="Right">
                    <Hyperlink Click="GeminiApiKeyGuide_Click"
                               Foreground="#C8DDCE"
                               TextDecorations="Underline">
                        Where can I get a Gemini API key?
                    </Hyperlink>
                                    </TextBlock>

                    <CheckBox x:Name="RememberMeCheckBox"
                      Content="Remember me"
                      Foreground="White"
                      Margin="0,0,0,18"/>

                    <TextBlock Text="Without an API key, AI features will be unavailable. You can still browse resources, add entries and complete translations manually."
                       Foreground="#D0D8D3"
                       FontSize="12"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,0,0,25"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"    
                        Foreground="#26352F"
                        Background="#E8F0E9"
                        Content="Add"
                        Click="AddApiKey_Click"/>

                        <Button Grid.Column="2"
                        Foreground="#26352F"
                        Background="#E8F0E9"
                        Content="Cancel"
                        Click="CancelApiKey_Click"/>

                    </Grid>

                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
