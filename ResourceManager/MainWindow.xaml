<Window x:Class="ResourceManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ResourceManager"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="1000">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Boczne menu -->
        <StackPanel Grid.Column="0"
                    Background="#26352F">

            <TextBlock Text="RESOURCE MANAGER"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="20,30,10,40"/>

            <Button Content="Dashboard"
                    Margin="10,5"
                    Padding="15"
                    Click="Dashboard_Click"/>

            <Button Content="Add Entry"
                    Margin="10,5"
                    Padding="15"
                    Click="AddEntry_Click"/>

            <Button Content="Complete Translations"
                    Margin="10,5"
                    Padding="15"
                    Click="CompleteTranslations_Click"/>

        </StackPanel>

        <!-- Obszar wyświetlania widoków -->
        <ContentControl x:Name="MainContent"
                        Grid.Column="1"/>
    </Grid>
</Window>
