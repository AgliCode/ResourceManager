<Window x:Class="ResourceManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ResourceManager"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="1000">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Boczne menu -->
        <StackPanel Grid.Column="0"
                    Background="#26352F">

            <TextBlock Text="RESOURCE MANAGER"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="20,30,10,40"/>

            <Button Content="Dashboard"
                    Margin="10,5"
                    Padding="15"
                    Click="Dashboard_Click"/>

            <Button Content="Add Entry"
                    Margin="10,5"
                    Padding="15"
                    Click="AddEntry_Click"/>

            <Button Content="Complete Translations"
                    Margin="10,5"
                    Padding="15"
                    Click="CompleteTranslations_Click"/>

            <Button Content="Add new language"
                Margin="10,5"
                Padding="15"
                Click="AddNewLanguage_Click"/>

        </StackPanel>

        <!-- Obszar wyświetlania widoków -->
        <ContentControl x:Name="MainContent"
                        Grid.Column="1"/>

        <Grid x:Name="FolderOverlay"
      Grid.ColumnSpan="2"
      Background="#CC000000"
      Panel.ZIndex="100">

            <Border Background="#26352F"
            CornerRadius="12"
            Padding="35"
            Width="420"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

                <StackPanel>
                    <TextBlock Text="RESOURCE MANAGER"
                       Foreground="White"
                       FontSize="22"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

                    <TextBlock Text="Select a project folder"
                       Foreground="White"
                       FontSize="20"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>

                    <TextBlock Text="To get started, choose a folder containing Resources.resx files"
                       Foreground="#D0D8D3"
                       FontSize="14"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,0,0,25"/>

                    <Button Content="Select a folder"
                    Padding="15,10"
                    FontSize="15"
                    Click="SelectProjectFolder_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
