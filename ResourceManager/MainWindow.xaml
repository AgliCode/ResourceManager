<Window x:Class="ResourceManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ResourceManager"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="1000">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Boczne menu -->
        <StackPanel Grid.Column="0" Background="#1D3025" Width="240">
            <StackPanel.Resources>
                <!-- Wspólny styl dla nowoczesnych przycisków menu (wzorowany na obrazku) -->
                <FontFamily x:Key="MaterialSymbols">/ResourceManager;component/Fonts/#Material Symbols Rounded</FontFamily>
                <Style x:Key="ModernMenuButtonStyle" TargetType="RadioButton">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#A3B899"/>
                    <Setter Property="Height" Value="42"/>
                    <Setter Property="Margin" Value="12,3,12,3"/>
                    <Setter Property="GroupName" Value="MenuTabs"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="RadioButton">
                                <!-- Zaokrąglone rogi (CornerRadius) całego przycisku -->
                                <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="10" 
                                SnapsToDevicePixels="True">
                                    <Grid Margin="15,0,15,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>


                                        <TextBlock Grid.Column="0" 
                                           Text="{TemplateBinding Tag}" 
                                           FontFamily="{StaticResource MaterialSymbols}"
                                           FontSize="16" 
                                           Foreground="{TemplateBinding Foreground}"
                                           VerticalAlignment="Center" 
                                           HorizontalAlignment="Left"
                                           Typography.StandardLigatures="True"/>

                                        <!-- Tekst przycisku -->
                                        <ContentPresenter Grid.Column="1" 
                                                  VerticalAlignment="Center" 
                                                  Margin="5,0,0,0"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <!-- Efekt po najechaniu myszką (Hover) -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#2A3F33"/>
                                        <Setter Property="Foreground" Value="#E2EBE0"/>
                                    </Trigger>
                                    <!-- Stan aktywny / kliknięty (Zaznaczony na obrazku Dashboard) -->
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#2D4639"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </StackPanel.Resources>

            <!-- Nagłówek MENU -->
            <TextBlock Text="MENU"
               Foreground="#738A75"
               FontSize="12"
               FontWeight="SemiBold"
               Margin="25,25,10,15"/>

            <!-- Przyciski nawigacyjne z dopasowanymi ikonami systemowymi Windows -->
            <RadioButton Content="Dashboard" 
                 Style="{StaticResource ModernMenuButtonStyle}" 
                 Tag="&#xE871;" 
                 IsChecked="True"
                 Click="Dashboard_Click"/>

            <RadioButton Content="Add Entry" 
                 Style="{StaticResource ModernMenuButtonStyle}" 
                 Tag="&#xe147;" 
                 Click="AddEntry_Click"/>

            <RadioButton Content="Complete Translations" 
                 Style="{StaticResource ModernMenuButtonStyle}" 
                 Tag="&#xe8e2;"
                 Click="CompleteTranslations_Click"/>

            <RadioButton Content="Add new language" 
                 Style="{StaticResource ModernMenuButtonStyle}" 
                 Tag="&#xe894;"
                 Click="AddNewLanguage_Click"/>

            <RadioButton Content="Browse Resources" 
                 Style="{StaticResource ModernMenuButtonStyle}" 
                 Tag="&#xe896;"
                 Click="BrowseResources_Click"/>

        </StackPanel>

        <!-- Obszar wyświetlania widoków -->
        <ContentControl x:Name="MainContent"
                        Grid.Column="1"/>

        <Grid x:Name="FolderOverlay"
      Grid.ColumnSpan="2"
      Background="#CC000000"
      Panel.ZIndex="100">

            <Border Background="#26352F"
            CornerRadius="12"
            Padding="35"
            Width="420"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

                <StackPanel>
                    <TextBlock Text="RESOURCE MANAGER"
                       Foreground="White"
                       FontSize="22"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

                    <TextBlock Text="Select a project folder"
                       Foreground="White"
                       FontSize="20"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>

                    <TextBlock Text="To get started, choose a folder containing Resources.resx files"
                       Foreground="#D0D8D3"
                       FontSize="14"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,0,0,25"/>

                    <Button Content="Select a folder"
                    Padding="15,10"
                    FontSize="15"
                    Click="SelectProjectFolder_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
