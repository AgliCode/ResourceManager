<UserControl x:Class="ResourceManager.Controls.LoadingOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:li="http://github.com/zeluisping/loadingIndicators/xaml/controls">

    <Grid Background="#B326352F"
          Visibility="Visible">

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <li:LoadingIndicator Mode="Ring"
                                 IsActive="True"
                                 Foreground="#FFFFFF"/>

            <TextBlock Text="Translating..."
                       Foreground="White"
                       FontSize="18"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,0" />

            <TextBlock Text="Please wait while AI processes your request."
                       Foreground="#D9FFFFFF"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0" />

        </StackPanel>
    </Grid>

</UserControl>