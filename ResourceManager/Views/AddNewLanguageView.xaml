<UserControl x:Class="ResourceManager.Views.AddNewLanguageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ResourceManager.Views"
             mc:Ignorable="d">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,0">
            <TextBlock Text="Add New Language"
                       FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="#26352F"/>

            <TextBlock Text="Create a new language file based on an existing RESX file."
                       FontSize="14"
                       Foreground="#777777"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Configuration -->
        <Border Grid.Row="1"
                x:Name="ConfigurationPanel"
                CornerRadius="8"
                Padding="25"
                Margin="0,30,0,0"
                MaxWidth="650"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">

            <StackPanel>
                <TextBlock Text="Language configuration"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#26352F"
                           Margin="0,0,0,20"/>

                <!-- Base file -->
                <TextBlock Text="Base file"
                           FontWeight="SemiBold"
                           Foreground="#555555"
                           Margin="0,0,0,8"/>

                <TextBox Text="Resources.resx"
                         IsReadOnly="True"
                         Padding="10"
                         FontSize="14"
                         Background="#EEEEEE"
                         Foreground="#666666"
                         BorderBrush="#E5E5E5"
                         BorderThickness="1"
                         Margin="0,0,0,20"/>

                <!-- Target language -->
                <TextBlock Text="Target language"
                           FontWeight="SemiBold"
                           Foreground="#555555"
                           Margin="0,0,0,8"/>

                <ComboBox x:Name="TargetLanguageComboBox"
                          Padding="8"
                          FontSize="14"
                          Background="White"
                          BorderBrush="#D9E0DB"
                          BorderThickness="1"
                          SelectedIndex="0"
                          Margin="0,0,0,20">
                    <ComboBoxItem Content="English (United States) - en-US"/>
                    <ComboBoxItem Content="German - de-DE"/>
                    <ComboBoxItem Content="French - fr-FR"/>
                    <ComboBoxItem Content="Spanish - es-ES"/>
                    <ComboBoxItem Content="Italian - it-IT"/>
                    <ComboBoxItem Content="Japanese - ja-JP"/>
                </ComboBox>

                <!-- Output file name -->
                <TextBlock Text="Output file name"
                           FontWeight="SemiBold"
                           Foreground="#555555"
                           Margin="0,0,0,8"/>

                <DockPanel LastChildFill="True"
                           Margin="0,0,0,25">
                    <TextBlock Text=".resx"
                               DockPanel.Dock="Right"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="#81766D"
                               Margin="8,0,0,0"/>

                    <TextBox x:Name="OutputFileNameTextBox"
                             Text="Resources.en-US"
                             Padding="10"
                             FontSize="14"
                             Background="White"
                             Foreground="#333333"
                             BorderBrush="#D9E0DB"
                             BorderThickness="1"/>
                </DockPanel>

                <!-- Continue -->
                <Button Content="Continue"
                        Height="42"
                        Width="140"
                        HorizontalAlignment="Right"
                        Background="#26352F"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Cursor="Hand" Click="Button_Click"/>

            </StackPanel>
        </Border>

        <!-- Entries selection -->
        <Border x:Name="EntriesPanel"
                Grid.Row="1"
                Background="#F5F7F5"
                CornerRadius="8"
                Padding="25"
                Margin="0,30,0,0"
                Visibility="Collapsed">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Select entries to translate"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#26352F"
                           Margin="0,0,0,20"/>

                <CheckBox x:Name="SelectAllCheckBox"
                          Checked="SelectAllCheckBox_Checked"
                          Unchecked="SelectAllCheckBox_Unchecked"
                          Grid.Row="1"
                          Content="Select all"
                          IsChecked="True"
                          FontWeight="SemiBold"
                          FontSize="14"
                          Foreground="#26352F"
                          Margin="0,0,0,15"/>

                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="EntriesItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E0E6E1"
                                        BorderThickness="0,0,0,1"
                                        Padding="10,14">

                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Checked="EntryCheckBox_Click"
                                              Unchecked="EntryCheckBox_Click"
                                              VerticalContentAlignment="Center">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Value}"
                                                       FontSize="14"
                                                       Foreground="#26352F"
                                                       TextWrapping="Wrap"/>

                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="11"
                                                       Foreground="#777777"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </CheckBox>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Button Grid.Row="3"
                        Content="Translate selected"
                        Height="42"
                        Width="170"
                        HorizontalAlignment="Right"
                        Background="#26352F"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Margin="0,20,0,0"
                        Click="TranslateSelected_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>

                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
