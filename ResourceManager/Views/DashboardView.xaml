<UserControl x:Class="ResourceManager.Views.DashboardView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ResourceManager.Views"
        mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,30">
                <TextBlock Text="Dashboard"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="#26352F"/>

                <TextBlock Text="Project translation overview"
                           FontSize="14"
                           Foreground="#777777"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Statistics -->
            <UniformGrid Grid.Row="1"
                         Columns="2"
                         Margin="0,0,0,25">

                <StackPanel Margin="0,0,20,20">
                    <TextBlock Text="Total Keys"
                               Foreground="#666666"
                               FontSize="14"/>
                    <TextBlock x:Name="TotalKeysText"
                               Text="—"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="Translated"
                               Foreground="#666666"
                               FontSize="14"/>
                    <TextBlock x:Name="TranslatedText"
                               Text="—"
                               Foreground="#16A34A"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Missing Translations"
                               Foreground="#666666"
                               FontSize="14"/>
                    <TextBlock x:Name="MissingTranslationsText"
                               Text="—"
                               Foreground="#DC2626"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Margin="0,5,0,0"/>
                </StackPanel>

            </UniformGrid>

            <!-- Progress -->
            <StackPanel Grid.Row="2" Margin="0,0,0,30">

                <Grid Margin="0,0,0,10">
                    <TextBlock Text="Translation Completion"
                               FontSize="14"
                               Foreground="#333333"/>

                    <TextBlock x:Name="CompletionText"
                               Text="—"
                               HorizontalAlignment="Right"
                               Foreground="#16A34A"
                               FontSize="14"
                               FontWeight="SemiBold"/>
                </Grid>

                <ProgressBar x:Name="CompletionProgressBar"
                             Height="10"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Background="#EEEEEE"
                             Foreground="#56866E"
                             BorderThickness="0"/>
            </StackPanel>

            <!-- Current project -->
            <Border Grid.Row="3"
                    Background="#F5F7F5"
                    CornerRadius="8"
                    Padding="18">

                <StackPanel>
                    <TextBlock Text="Current Project"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#26352F"
                               Margin="0,0,0,12"/>

                    <TextBlock x:Name="ProjectNameText"
                               Text="No project selected"
                               FontSize="15"
                               FontWeight="Medium"/>

                    <TextBlock x:Name="ProjectPathText"
                               Text="Select a project folder to get started."
                               Foreground="#777777"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,5,0,0"/>
                </StackPanel>

            </Border>

        </Grid>
    </ScrollViewer>
</UserControl>
