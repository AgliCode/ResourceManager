<UserControl x:Class="ResourceManager.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ResourceManager.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="25">
            <StackPanel>

                <!-- Header -->
                <StackPanel Margin="0,0,0,25">
                    <TextBlock Text="Settings"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Foreground="#26352B"/>

                    <TextBlock Text="Manage your project configuration and API preferences."
                               FontSize="13"
                               Foreground="#888888"
                               Margin="0,6,0,0"/>
                </StackPanel>


                <!-- PROJECT CONFIGURATION -->
                <Border Background="#F5F7F5"
                        CornerRadius="8"
                        Padding="18"
                        Margin="0,0,0,20">

                    <StackPanel>

                        <TextBlock Text="Project Configuration"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#26352F"
                                   Margin="0,0,0,5"/>

                        <TextBlock Text="Manage the files and language used in your project."
                                   FontSize="12"
                                   Foreground="#777777"
                                   Margin="0,0,0,18"/>


                        <!-- Project folder -->
                        <TextBlock Text="Project folder"
                                   FontWeight="SemiBold"
                                   Foreground="#444444"
                                   Margin="0,0,0,7"/>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="ProjectFolderTextBox"
                                     Grid.Column="0"
                                     Text="Current project folder"
                                     IsReadOnly="True"
                                     Padding="12,10"
                                     FontSize="13"
                                     Background="#FFFFFF"
                                     BorderBrush="#E5E5E5"
                                     VerticalContentAlignment="Center"/>

                            <Button Grid.Column="1"
                                    Content="Change"
                                    Click="Change_Click"
                                    Margin="10,0,0,0"
                                    Padding="20,8"
                                    Background="#E8F0E9"
                                    Foreground="#42634A"
                                    BorderThickness="0"
                                    FontWeight="SemiBold"/>
                        </Grid>


                        <!-- Base file -->
                        <TextBlock Text="Base file"
                                   FontWeight="SemiBold"
                                   Foreground="#444444"
                                   Margin="0,0,0,7"/>

                        <ComboBox x:Name="BaseFileComboBox"
                                  Height="38"
                                  Padding="10,5"
                                  FontSize="13"
                                  Background="#FFFFFF"
                                  Margin="0,0,0,18"/>


                        <!-- Target file -->
                        <TextBlock Text="Target file"
                                   FontWeight="SemiBold"
                                   Foreground="#444444"
                                   Margin="0,0,0,7"/>

                        <ComboBox x:Name="TargetFileComboBox"
                                  Height="38"
                                  Padding="10,5"
                                  FontSize="13"
                                  Background="#FFFFFF"
                                  Margin="0,0,0,18"/>


                        <!-- Target language -->
                        <TextBlock Text="Target language"
                                   FontWeight="SemiBold"
                                   Foreground="#444444"
                                   Margin="0,0,0,7"/>

                        <ComboBox x:Name="TargetLanguageComboBox"
                                  Height="38"
                                  Padding="10,5"
                                  FontSize="13"
                                  Background="#FFFFFF">
                            <ComboBoxItem Content="English (United States) - en-US" Tag="en-US"/>
                            <ComboBoxItem Content="English (United Kingdom) - en-GB" Tag="en-GB"/>
                            <ComboBoxItem Content="Polish - pl-PL" Tag="pl-PL"/>
                            <ComboBoxItem Content="German - de-DE" Tag="de-DE"/>
                            <ComboBoxItem Content="French - fr-FR" Tag="fr-FR"/>
                            <ComboBoxItem Content="Spanish - es-ES" Tag="es-ES"/>
                            <ComboBoxItem Content="Italian - it-IT" Tag="it-IT"/>
                            <ComboBoxItem Content="Ukrainian - uk-UA" Tag="uk-UA"/>
                        </ComboBox>

                    </StackPanel>
                </Border>


                <!-- GEMINI API KEY -->
                <Border Background="#F5F7F5"
                        CornerRadius="8"
                        Padding="18"
                        Margin="0,0,0,20">

                    <StackPanel>

                        <TextBlock Text="Gemini API Key"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#26352F"
                                   Margin="0,0,0,5"/>

                        <TextBlock Text="Manage your Gemini API key and its storage preferences."
                                   FontSize="12"
                                   Foreground="#777777"
                                   Margin="0,0,0,18"/>


                        <!-- Key status -->
                        <Border Background="#FFFFFF"
                                CornerRadius="8"
                                Padding="15"
                                Margin="0,0,0,18">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="API key status"
                                               FontWeight="SemiBold"
                                               Foreground="#444444"/>

                                    <TextBlock x:Name="ApiKeyStatusText"
                                               Text="API key is configured"
                                               FontSize="12"
                                               Foreground="#777777"
                                               Margin="0,5,0,0"/>
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Background="#E2F1E4"
                                        CornerRadius="8"
                                        Padding="12,5"
                                        VerticalAlignment="Center">

                                    <TextBlock x:Name="ApiKeyStatusBadge"
                                               Text="Configured"
                                               Foreground="#39734A"
                                               FontSize="11"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                        </Border>


                        <!-- API key input -->
                        <TextBlock Text="API key"
                                   FontWeight="SemiBold"
                                   Foreground="#444444"
                                   Margin="0,0,0,7"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <PasswordBox x:Name="ApiKeyPasswordBox"
                                         Grid.Column="0"
                                         Padding="12,10"
                                         FontSize="13"
                                         Height="38"
                                         Background="#FFFFFF"
                                         BorderBrush="#E5E5E5"/>

                            <Button Grid.Column="1"
                                    Content="Show"
                                    Margin="10,0,0,0"
                                    Padding="18,8"
                                    Background="#FFFFFF"
                                    Foreground="#555555"
                                    BorderThickness="0"/>
                        </Grid>


                        <!-- Remember me -->
                        <CheckBox x:Name="RememberMeCheckBox"
                                  Content="Remember me"
                                  FontSize="13"
                                  Foreground="#555555"
                                  Margin="0,5,0,18"/>


                        <!-- API key actions -->
                        <WrapPanel>
                            <Button Content="Save API key"
                                    Padding="20,10"
                                    Background="#58785D"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontWeight="SemiBold"
                                    Margin="0,0,10,0"/>

                            <Button Content="Remove API key"
                                    Padding="20,10"
                                    Background="#F8EEEE"
                                    Foreground="#A34B4B"
                                    BorderThickness="0"
                                    FontWeight="SemiBold"/>
                        </WrapPanel>

                    </StackPanel>
                </Border>


                <!-- PROJECT ACTIONS -->
                <Border Background="#F5F7F5"
                        CornerRadius="8"
                        Padding="18"
                        Margin="0,0,0,20">

                    <StackPanel>

                        <TextBlock Text="Project Actions"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#26352F"
                                   Margin="0,0,0,5"/>

                        <TextBlock Text="Return to the initial project configuration."
                                   FontSize="12"
                                   Foreground="#777777"
                                   Margin="0,0,0,15"/>

                        <Button Content="Change project folder"
                                HorizontalAlignment="Left"
                                Padding="20,10"
                                Background="#E8F0E9"
                                Foreground="#42634A"
                                BorderThickness="0"
                                FontWeight="SemiBold"/>

                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
