<UserControl x:Class="ResourceManager.Views.CompleteTranslationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:ResourceManager.Views"
             mc:Ignorable="d">

    <UserControl.Resources>
        <FontFamily x:Key="MaterialSymbols">/ResourceManager;component/Fonts/#Material Symbols Rounded</FontFamily>
    </UserControl.Resources>

    <Grid Background="White" Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                VerticalAlignment="Center">
                <TextBlock Text="Complete Translations"
                   FontSize="26"
                   FontWeight="SemiBold"
                   Foreground="#26352F"/>

                <TextBlock Text="Review and complete missing translations in your resource files."
                   FontSize="14"
                   Foreground="#777777"
                   Margin="0,6,0,0"/>
            </StackPanel>

            <Button x:Name="GenerateAIButton"
            Grid.Column="1"
            Height="40"
            Padding="16,0"
            Background="#26352F"
            Foreground="White"
            BorderThickness="0"
            Cursor="Hand"
            Click="GenerateAIButton_Click"
            VerticalAlignment="Center">

                <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center">

                    <TextBlock 
                       x:Name="GenerateAIIcon"
                       Text="&#xf31c;"
                       FontFamily="{StaticResource MaterialSymbols}"
                       FontSize="18"
                       Margin="0,0,8,0"
                       Typography.StandardLigatures="True"/>

                    <TextBlock
                       Text="Generate AI Translations"
                       FontSize="13"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Main content -->
        <Grid Grid.Row="1" Margin="0,25,0,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.85*"/>
                <ColumnDefinition Width="1.15*"/>
            </Grid.ColumnDefinitions>

            <!-- Left panel: Resource keys -->
            <Border Grid.Column="0"
                    Background="#FFFFFF"
                    BorderBrush="#E5E5E5"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18"
                    Margin="0,0,10,0">

                <ListBox x:Name="IncompleteEntriesList"
                         SelectionChanged="IncompleteEntriesList_SelectionChanged"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionMode="Single">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal"
                                        Margin="5,8">
                                <TextBlock Text="{Binding Name}"
                                           VerticalAlignment="Center"
                                           Foreground="#444444"
                                           FontSize="14"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>
            </Border>

            <!-- Right panel: Translation form -->
            <Border Grid.Column="1"
                    Background="#FFFFFF"
                    BorderBrush="#E5E5E5"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="22"
                    Margin="10,0,0,0">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel>

 
                        <TextBlock Text="Name"/>

                        <TextBox x:Name="NameTextBox"
                                 Margin="0,0,0,18"/>

                        <TextBlock Text="Value"/>

                        <TextBox x:Name="ValueTextBox"
                                 Height="65"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalContentAlignment="Top"
                                 Margin="0,0,0,18"/>

                        <TextBlock Text="Comment"/>

                        <TextBox x:Name="CommentTextBox"                             
                                 Height="65"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalContentAlignment="Top"
                                 Margin="0,0,0,18"/>


                        <TextBlock Text="Translated value"/>

                        <TextBox x:Name="TargetValueTextBox" 
                                 Height="65"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalContentAlignment="Top"
                                 Margin="0,0,0,22"/>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="PreviousButton"
                                    Grid.Column="0"
                                    IsEnabled="False"
                                    Width="45"
                                    Height="45"
                                    HorizontalAlignment="Left"
                                    Click="PreviousEntry_Click">

                                <TextBlock Text="&#xe5c4;"
                                           FontFamily="{StaticResource MaterialSymbols}"
                                           FontSize="20"
                                           Typography.StandardLigatures="True"/>
                            </Button>

                            <Button x:Name="NextButton"
                                    Grid.Column="1"
                                    IsEnabled="False"
                                    Width="45"
                                    Height="45"
                                    HorizontalAlignment="Right"
                                    Click="NextEntry_Click">

                                <TextBlock Text="&#xe5c8;"
                                           FontFamily="{StaticResource MaterialSymbols}"
                                           FontSize="20"
                                           Typography.StandardLigatures="True"/>
                            </Button>
                        </Grid>

                        <Button Content="Approve and Next"
                                Click="ApproveAndNext_Click"/>

                    </StackPanel>
                </ScrollViewer>
            </Border>

        </Grid>

        <Button Grid.Row="2"
                Content="Save All"
                Click="SaveAll_Click"
                Background="#26352D"
        Foreground="White"
                Height="45"
                HorizontalAlignment="Stretch"/>

    </Grid>
</UserControl>
