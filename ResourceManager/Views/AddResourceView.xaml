<UserControl x:Class="ResourceManager.Views.AddResourceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ResourceManager.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="25">
            <Border Background="#FFFFFF"
                    BorderBrush="#E5E5E5"
                    Padding="25">

                <StackPanel>

                    <!-- Header -->
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Add new resource"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="#26352F"/>

                        <TextBlock Text="Add a new resource key to both the base and target resource files."
                           FontSize="14"
                           Foreground="#777777"
                           Margin="0,6,0,10"/>
                    </StackPanel>

                    <!-- Key name -->
                    <TextBlock Text="Key name"
                               FontSize="15"
                               Foreground="#555555"
                               Margin="0,0,0,7"/>

                    <TextBox x:Name="KeyNameTextBox"
                             Height="50"
                             FontSize="17"
                             Padding="15,10"
                             BorderBrush="#E5E5E5"
                             BorderThickness="1"
                             Background="#FFFFFF"
                             VerticalContentAlignment="Center"
                             Margin="0,0,0,18"/>

                    <!-- Neutral value -->
                    <TextBlock Text="Value"
                               FontSize="15"
                               Foreground="#555555"
                               Margin="0,0,0,7"/>

                    <TextBox x:Name="NeutralValueTextBox"
                             Height="50"
                             FontSize="17"
                             Padding="15,10"
                             BorderBrush="#E5E5E5"
                             BorderThickness="1"
                             Background="#FFFFFF"
                             VerticalContentAlignment="Center"
                             Margin="0,0,0,18"/>

                    <!-- Neutral comment -->
                    <TextBlock Text="Comment"
                               FontSize="15"
                               Foreground="#555555"
                               Margin="0,0,0,7"/>

                    <TextBox x:Name="NeutralCommentTextBox"
                             Height="60"
                             FontSize="17"
                             Padding="15,10"
                             BorderBrush="#E5E5E5"
                             BorderThickness="1"
                             Background="#FFFFFF"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,18"/>

                    <!-- Target value -->
                    <Grid Margin="0,0,0,7">
                        <TextBlock x:Name="TargetValueLabel"
                                   Text="Target value"
                                   FontSize="15"
                                   Foreground="#555555"
                                   VerticalAlignment="Center"/>

                        <Border Background="#D9F4E4"
                                CornerRadius="12"
                                Padding="10,4"
                                HorizontalAlignment="Right">
                            <TextBlock Text="AI suggestion"
                                       Foreground="#168348"
                                       FontSize="13"/>
                        </Border>
                    </Grid>

                    <TextBox x:Name="TargetValueTextBox"
                             Height="50"
                             FontSize="17"
                             Padding="15,10"
                             BorderBrush="#E5E5E5"
                             BorderThickness="1"
                             Background="#FFFFFF"
                             VerticalContentAlignment="Center"
                             Margin="0,0,0,18"/>

                    <!-- Buttons -->
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                x:Name="SuggestTranslationButton"
                                Click="SuggestTranslationButton_Click"
                                Content="Suggest translation"
                                Background="Transparent"
                                Foreground="#26352F"/>

                        <Button Grid.Column="2"
                                x:Name="AddEntryButton"
                                Click="AddEntryButton_Click"
                                Content="Add entry"
                                Background="#365744"
                                Foreground="White"/>
                    </Grid>

                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
